# InterviewAI Backend Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
# If MongoDB is running locally or Atlas, set URI here.
# If MongoDB is not running, the server gracefully activates its persistent embedded JSON database.
MONGODB_URI=mongodb://127.0.0.1:27017/interviewai

# Authentication Secret
JWT_SECRET=interviewai_super_secret_jwt_key_2026_dev_secure

# AI Service Configuration
# Optional: Provide GEMINI_API_KEY or OPENAI_API_KEY to switch from the built-in AI simulator to live LLM.
# Keep empty to use the realistic simulated AI engine.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Client URL for CORS
CLIENT_URL=http://localhost:5173
